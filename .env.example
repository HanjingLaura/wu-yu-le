# SQLite local fallback (run `npm run db:push` once)
DATABASE_URL="file:./dev.db"

# NextAuth/Auth.js session encryption
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Development mail: console prints verification/reset links; use resend when configured.
MAIL_MODE="console"
EMAIL_FROM="WuyuLe <onboarding@resend.dev>"
# Optional Resend transport (if set, links are delivered instead of only logged)
RESEND_API_KEY=""
RESEND_FROM="WuyuLe <onboarding@resend.dev>"

# Upload seam; local implementation can write here, S3-compatible storage can replace it.
UPLOAD_DIR="./uploads"
# S3-compatible placeholder (optional)
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
