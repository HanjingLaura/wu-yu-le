# SQLite local fallback: DATABASE_URL="file:./dev.db" (run `npm run db:push` once)
# Production / Vercel Marketplace Postgres (Neon etc.): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/wuyule?schema=public"
# Optional. with-env.mjs infers sqlite from file: URLs; set to force a provider.
# PRISMA_PROVIDER="postgresql"

# NextAuth/Auth.js — include the app basePath `/wuyule`. Do not hardcode a host
# that you are not deploying to. Examples:
#   http://localhost:3000/wuyule
#   https://hanjing-laura.vercel.app/wuyule
#   https://wu-yu-le.vercel.app/wuyule
NEXTAUTH_URL="http://localhost:3000/wuyule"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Development mail: console prints verification/reset links; use resend when configured.
MAIL_MODE="console"
EMAIL_FROM="WuyuLe <onboarding@resend.dev>"
# Optional Resend transport (if set, links are delivered instead of only logged)
RESEND_API_KEY=""
RESEND_FROM="WuyuLe <onboarding@resend.dev>"

# Upload seam; local implementation can write here, S3-compatible storage can replace it.
UPLOAD_DIR="./uploads"
# S3-compatible placeholder (optional)
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
